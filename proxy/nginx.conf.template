# Include inside the existing HTTP or HTTPS server { } block.
# The existing server keeps its listen, server_name and TLS settings.
location = /ai {
    return 302 /ai/;
}
location ^~ /ai/ {
    proxy_pass http://127.0.0.1:__AI_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    client_max_body_size 30m;
    gzip off;
}

