# Include inside the existing HTTP or HTTPS <VirtualHost>.
# Requires mod_proxy, mod_proxy_http, mod_alias and mod_env.
ProxyRequests Off
RedirectMatch 302 ^/ai$ /ai/
ProxyPass /ai/ http://127.0.0.1:__AI_PORT__/ai/ connectiontimeout=5 timeout=600
ProxyPassReverse /ai/ http://127.0.0.1:__AI_PORT__/ai/
<Location /ai/>
    ProxyPreserveHost On
    LimitRequestBody 31457280
    SetEnv no-gzip 1
</Location>

