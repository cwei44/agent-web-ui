# Include inside the existing HTTP or HTTPS <VirtualHost>.
# Requires mod_proxy, mod_proxy_http, mod_alias and mod_env.
ProxyRequests Off
RedirectMatch 302 ^/claude$ /claude/
ProxyPass /claude/ http://127.0.0.1:__CLAUDE_PORT__/claude/ connectiontimeout=5 timeout=600
ProxyPassReverse /claude/ http://127.0.0.1:__CLAUDE_PORT__/claude/
<Location /claude/>
    ProxyPreserveHost On
    LimitRequestBody 31457280
    SetEnv no-gzip 1
</Location>
